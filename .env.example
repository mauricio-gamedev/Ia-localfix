IA_DATABASE_PATH=./data/ia-localfix.sqlite3
IA_WORKSPACE_ROOT=./workspaces
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
IA_MAX_PLAN_CHARS=12000
IA_ARTIFACT_ROOT=./artifacts
IA_DOCKER_BINARY=docker
IA_PYTHON_BUILDER_IMAGE=python:3.12-slim
IA_NODE_BUILDER_IMAGE=node:22-bookworm-slim
# Set only on the API host after provisioning a compatible offline Android SDK image.
IA_ANDROID_BUILDER_IMAGE=
IA_BUILD_TIMEOUT_SECONDS=900
IA_BUILD_MEMORY_LIMIT=2g
IA_BUILD_CPUS=2.0
IA_BUILD_PIDS_LIMIT=128

IA_MAX_REPAIR_ITERATIONS=2
